# Copy to .env (git-ignored). Generate secrets with: python3 -c "import secrets;print(secrets.token_hex(24))"
SPXQ_API_KEY=
SPXQ_DB_PASSWORD=

# Data source:
#   Replay          bundled SYNTHETIC fixture (no credentials)
#   TradierReadOnly live Tradier market data (needs TRADIER_TOKEN; GET /v1/markets/* only)
#   RecordedReplay  replay what the recorder captured (needs SPXQ_REPLAY_START, e.g. 2026-11-02T15:00:00Z)
SPXQ_DATA_SOURCE=Replay
TRADIER_TOKEN=
SPXQ_REPLAY_START=

# Record live chain snapshots + 1m bars during market hours (TradierReadOnly only)
SPXQ_RECORDER=false

# Vendor | LocalEstimated | VendorThenLocal  (see docs/06-usage.md before changing)
SPXQ_GREEKS_SOURCE=LocalEstimated
